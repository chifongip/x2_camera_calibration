<?xml version="1.0"?>
<package format="3">
  <name>x2_camera_calibration</name>
  <version>0.1.0</version>
  <description>Passive checkerboard calibration of the torso-mounted Odin camera.</description>
  <maintainer email="oscar.ip@lscm.hk">oscar</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>aimdk_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>x2_description</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
